name: scan-to-text

  services:
    db:
      image: postgres:17-bookworm
      restart: unless-stopped

      environment:
        POSTGRES_DB: scan_data
        POSTGRES_USER: scan_app
        POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}

      volumes:
        - postgres_data:/var/lib/postgresql/data

      healthcheck:
        test: ["CMD-SHELL", "pg_isready -U scan_app -d scan_data"]
        interval: 10s
        timeout: 5s
        retries: 10
        start_period: 20s

    redis:
      image: redis:7-alpine
      restart: unless-stopped
      command: ["redis-server", "--save", "", "--appendonly", "no"]
      # Development-only: Redis stays on the internal Compose network.
      # Production must use a managed private TLS endpoint (rediss://).

    app:
      build:
        context: .
        dockerfile: Dockerfile

      restart: unless-stopped
      init: true

      depends_on:
        db:
          condition: service_healthy
        redis:
          condition: service_started

      environment:
        DATABASE_URL: postgresql+psycopg://scan_app:${POSTGRES_PASSWORD}@db:5432/scan_data
        SECRET_KEY: ${SECRET_KEY}
        INITIAL_ADMIN_PASSWORD: ${INITIAL_ADMIN_PASSWORD}
        REDIS_URL: redis://redis:6379/0

        PDF_STORAGE_PATH: /app/uploads
        TEMPLATE_STORAGE_PATH: /app/templates
        DOCUMENT_SOURCE_ROOT: /app/source_documents

        CORS_ORIGINS: ""

        DB_POOL_SIZE: "10"
        DB_MAX_OVERFLOW: "10"
        DB_POOL_TIMEOUT: "30"
        DB_POOL_RECYCLE: "1800"

        PROJECT_UPLOAD_CHUNK_BYTES: "8388608"
        PROJECT_UPLOAD_CONCURRENCY: "4"

      ports:
        - "8080:8000"

      volumes:
        - type: bind
          source: ./docker-data/uploads
          target: /app/uploads

        - type: bind
          source: ./docker-data/templates
          target: /app/templates

        - type: bind
          source: ./docker-data/source_documents
          target: /app/source_documents
          read_only: true

        - type: bind
          source: ./docker-data/logs
          target: /app/logs

      healthcheck:
        test:
          [
            "CMD",
            "python",
            "-c",
            "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/', timeout=3)"
          ]
        interval: 30s
        timeout: 5s
        retries: 5
        start_period: 30s

  volumes:
    postgres_data:
