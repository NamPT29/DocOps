# Generate a random value of at least 32 bytes for production.
SECRET_KEY=

# Required only when bootstrapping the first administrator (minimum 12 characters).
INITIAL_ADMIN_PASSWORD=

DATABASE_URL=mysql+pymysql://user:password@127.0.0.1/database
PDF_STORAGE_PATH=uploads
# Server-side source tree that administrators can browse and import.
DOCUMENT_SOURCE_ROOT=source_documents

# Comma-separated browser origins. Leave empty for same-origin deployments.
CORS_ORIGINS=
HOST=0.0.0.0
PORT=80
